generator client {
  provider = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  user_id    Int      @id @default(autoincrement())
  username   String   @unique @db.VarChar(50)
  email      String   @unique @db.VarChar(100)
  password   String   @db.Text
  name       String?  @db.VarChar(100)
  role       String   @db.VarChar(30)
  created_at DateTime @default(now())

  ratings        ratings[]
  comments       comments[]
  replies        replies[]
  payments       payments[]
  user_books     user_books[]
  liked_books    liked_books[]

  book_requests  BookRequest[]  
}

model books {
  book_id        Int               @id @default(autoincrement())
  isbn           String            @db.VarChar(13)
  name           String            @db.VarChar(200)
  author         String?           @db.VarChar(100)
  description    String?           @db.Text
  published_date Int
  cover_image    String?           @db.VarChar(255)
  file_path      String?           @db.VarChar(500)
  price          Decimal           @default(0.00) @db.Decimal(10,2)
  created_at     DateTime          @default(now())
  state          Boolean           @default(false)

  book_photos       book_photos[]
  book_category_links book_category_links[]
  ratings           ratings[]
  comments          comments[]
  payments          payments[]
  user_books        user_books[]
  liked_books       liked_books[]
}

model book_photos {
  photo_id   Int      @id @default(autoincrement())
  book_id    Int
  url        String   @db.VarChar(1024)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  book books @relation(fields: [book_id], references: [book_id], onDelete: Cascade)
}

model book_categories {
  category_id   Int    @id @default(autoincrement())
  category_name String @db.VarChar(255)

  book_category_links book_category_links[]
}

model book_category_links {
  book_id    Int
  category_id Int

  book     books           @relation(fields: [book_id], references: [book_id], onDelete: Cascade)
  category book_categories @relation(fields: [category_id], references: [category_id], onDelete: Cascade)

  @@id([book_id, category_id])
}

model ratings {
  rating_id  Int      @id @default(autoincrement())
  book_id    Int
  user_id    Int
  rating     Int
  review     String?  @db.Text
  created_at DateTime @default(now())

  book books @relation(fields: [book_id], references: [book_id])
  user users @relation(fields: [user_id], references: [user_id])
}

model comments {
  comment_id Int      @id @default(autoincrement())
  book_id    Int
  user_id    Int
  content    String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  book    books  @relation(fields: [book_id], references: [book_id], onDelete: Cascade, onUpdate: Cascade)
  user    users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  replies replies[]
}

model replies {
  reply_id   Int      @id @default(autoincrement())
  comment_id Int
  user_id    Int
  content    String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  comment comments @relation(fields: [comment_id], references: [comment_id], onDelete: Cascade)
  user    users    @relation(fields: [user_id], references: [user_id])
}

model payments {
  pay_id  Int      @id @default(autoincrement())
  user_id Int
  book_id Int
  amount  Decimal  @db.Decimal(10,2)
  status  String   @db.VarChar(20)
  paid_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  book books @relation(fields: [book_id], references: [book_id], onDelete: Cascade, onUpdate: Cascade)
}

model user_books {
  id           Int      @id @default(autoincrement())
  user_id      Int
  book_id      Int
  purchased_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  book books @relation(fields: [book_id], references: [book_id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([user_id, book_id])
}

model liked_books {
  id        Int      @id @default(autoincrement())
  user_id   Int
  book_id   Int
  liked_at  DateTime @default(now())

  user users @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  book books @relation(fields: [book_id], references: [book_id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([user_id, book_id])
}

model BookRequest {
  id             Int       @id @default(autoincrement())
  type           String    // 'add' | 'update' | 'delete'
  status         String    @default("pending") // 'pending' | 'approved' | 'rejected'
  requested_at   DateTime  @default(now())
  processed_at   DateTime?
  
  book_title     String    @db.VarChar(200)
  isbn           String    @db.VarChar(13)
  author         String?   @db.VarChar(100)
  description    String?   @db.Text
  cover_image    String?   @db.VarChar(255)
  file_path      String?   @db.VarChar(500)
  price          Decimal   @db.Decimal(10,2)
  published_date Int

  book_id        Int?      // chỉ dùng cho 'update' và 'delete'
  user_id        Int
  user           users     @relation(fields: [user_id], references: [user_id])
}

